//@version=6
indicator("v8.1α-ZZ-MTA-5P-B5.2 Indicator v0.4 - Break Pivot Away Retest Guard", overlay = true, max_labels_count = 500, max_lines_count = 500, max_bars_back = 5000)

//=============================================================================
// Inputs
//=============================================================================

htfTf = input.timeframe("60", "ZZ-MTA計算時間足", group = "HTF ZZ-MTA")

reversalMode = input.string("ATR", "ZigZag反転幅モード", options = ["ATR", "Ticks", "Percent"], group = "ZigZag Confirmed Engine")

atrLength = input.int(14, "ATR Length", minval = 1, group = "ZigZag Confirmed Engine")
atrMultiplier = input.float(2.0, "ATR倍率", minval = 0.1, step = 0.1, group = "ZigZag Confirmed Engine")

reversalTicks = input.int(100, "固定Ticks反転幅", minval = 1, group = "ZigZag Confirmed Engine")
reversalPercent = input.float(0.1, "Percent反転幅", minval = 0.01, step = 0.01, group = "ZigZag Confirmed Engine")

triggerLeftBars = input.int(6, "Trigger 左ピボット本数", minval = 1, group = "B5.2 Trigger")
triggerRightBars = input.int(6, "Trigger 右ピボット本数", minval = 1, group = "B5.2 Trigger")
triggerExpireMinutes = input.int(240, "Trigger有効期限（分）", minval = 1, group = "B5.2 Trigger")

showHtfMtaZone = input.bool(true, "HTF ZZ-MTAゾーンを表示", group = "表示")
showHtfMtaLine = input.bool(true, "HTF ZZ-MTAラインを表示", group = "表示")
showHtfAnchorLine = input.bool(true, "HTF対応高値/安値ラインを表示", group = "表示")
showFivePZone = input.bool(true, "5P Zoneを表示", group = "表示")
showFivePSetupLabels = input.bool(true, "5P Setupラベルを表示", group = "表示")
showTriggerLabels = input.bool(true, "Triggerラベルを表示", group = "表示")
showInvalidLabels = input.bool(true, "Setup失効ラベルを表示", group = "表示")
showTriggerPivots = input.bool(true, "Trigger基準H/Lを表示", group = "表示")
showFivePSlLine = input.bool(true, "5P Zone Opposite SL候補を表示", group = "表示")
showDebug = input.bool(false, "状態をデータウィンドウに表示", group = "Debug")

bullMtaColor = input.color(color.blue, "Bull MTA色", group = "色")
bearMtaColor = input.color(color.fuchsia, "Bear MTA色", group = "色")
endedMtaColor = input.color(color.gray, "終了MTA色", group = "色")
anchorColor = input.color(color.orange, "対応高値/安値色", group = "色")

fivePBullColor = input.color(color.lime, "Bull 5P Zone色", group = "色")
fivePBearColor = input.color(color.red, "Bear 5P Zone色", group = "色")
setupLongColor = input.color(color.green, "Long 5P Setup色", group = "色")
setupShortColor = input.color(color.red, "Short 5P Setup色", group = "色")
triggerLongColor = input.color(color.lime, "Long Trigger色", group = "色")
triggerShortColor = input.color(color.red, "Short Trigger色", group = "色")
slColor = input.color(color.yellow, "5P SL候補色", group = "色")

//=============================================================================
// Helper Functions
//=============================================================================

reversalAmount(refPrice) =>
    float atrValueLocal = ta.atr(atrLength)
    float result = na
    if reversalMode == "ATR"
        result := atrValueLocal * atrMultiplier
    if reversalMode == "Ticks"
        result := reversalTicks * syminfo.mintick
    if reversalMode == "Percent"
        result := refPrice * reversalPercent / 100.0
    result

bodyHighAtBar(targetBar) =>
    float result = na
    int barsBack = bar_index - targetBar
    if barsBack >= 0
        if barsBack <= 500
            result := math.max(open[barsBack], close[barsBack])
    result

bodyLowAtBar(targetBar) =>
    float result = na
    int barsBack = bar_index - targetBar
    if barsBack >= 0
        if barsBack <= 500
            result := math.min(open[barsBack], close[barsBack])
    result

mtaBodyHighMaxFromBar(mtaBar) =>
    float result = na
    int barsBack = bar_index - mtaBar
    int limit = math.min(barsBack, 500)
    if limit >= 0
        for i = 0 to limit
            bodyHigh = math.max(open[i], close[i])
            result := na(result) ? bodyHigh : math.max(result, bodyHigh)
    result

mtaBodyLowMinFromBar(mtaBar) =>
    float result = na
    int barsBack = bar_index - mtaBar
    int limit = math.min(barsBack, 500)
    if limit >= 0
        for i = 0 to limit
            bodyLow = math.min(open[i], close[i])
            result := na(result) ? bodyLow : math.min(result, bodyLow)
    result

floatChanged(a, b) =>
    bool result = false
    if na(a)
        if not na(b)
            result := true
    if not na(a)
        if na(b)
            result := true
        else
            if a != b
                result := true
    result

//=============================================================================
// HTF ZZ-MTA + 5P Zone Engine
//=============================================================================

calcZzMtaFiveP() =>
    var int swingDir = 0

    var float rangeHigh = na
    var int rangeHighBar = na
    var int rangeHighTime = na

    var float rangeLow = na
    var int rangeLowBar = na
    var int rangeLowTime = na

    var float candidateHigh = na
    var int candidateHighBar = na
    var int candidateHighTime = na

    var float candidateLow = na
    var int candidateLowBar = na
    var int candidateLowTime = na

    var array<float> zzPrices = array.new_float()
    var array<int> zzTypes = array.new_int()
    var array<int> zzBars = array.new_int()
    var array<int> zzTimes = array.new_int()

    var int mtaTrend = 0
    var float mtaPrice = na
    var int mtaBar = na
    var int mtaTime = na
    var float mtaZoneTop = na
    var float mtaZoneBottom = na

    var float anchorPrice = na
    var int anchorBar = na
    var int anchorTime = na

    var float fivePZoneTop = na
    var float fivePZoneBottom = na

    bool confirmedSwing = false
    int confirmedType = 0
    float confirmedPrice = na
    int confirmedBar = na
    int confirmedTime = na

    bool mtaStarted = false
    bool mtaEnded = false

    if barstate.isconfirmed
        confirmedSwing := false
        confirmedType := 0
        confirmedPrice := na
        confirmedBar := na
        confirmedTime := na

        mtaStarted := false
        mtaEnded := false

        if na(rangeHigh)
            rangeHigh := high
            rangeHighBar := bar_index
            rangeHighTime := time

        if na(rangeLow)
            rangeLow := low
            rangeLowBar := bar_index
            rangeLowTime := time

        if swingDir == 0
            if high > rangeHigh
                rangeHigh := high
                rangeHighBar := bar_index
                rangeHighTime := time

            if low < rangeLow
                rangeLow := low
                rangeLowBar := bar_index
                rangeLowTime := time

            float initAmount = reversalAmount(close)
            bool rangeReady = false

            if not na(initAmount)
                if rangeHigh - rangeLow >= initAmount
                    rangeReady := true

            if rangeReady
                if close >= open
                    confirmedSwing := true
                    confirmedType := -1
                    confirmedPrice := rangeLow
                    confirmedBar := rangeLowBar
                    confirmedTime := rangeLowTime

                    swingDir := 1
                    candidateHigh := rangeHigh
                    candidateHighBar := rangeHighBar
                    candidateHighTime := rangeHighTime
                    candidateLow := na
                    candidateLowBar := na
                    candidateLowTime := na

                if close < open
                    confirmedSwing := true
                    confirmedType := 1
                    confirmedPrice := rangeHigh
                    confirmedBar := rangeHighBar
                    confirmedTime := rangeHighTime

                    swingDir := -1
                    candidateLow := rangeLow
                    candidateLowBar := rangeLowBar
                    candidateLowTime := rangeLowTime
                    candidateHigh := na
                    candidateHighBar := na
                    candidateHighTime := na

        if swingDir == 1
            if na(candidateHigh)
                candidateHigh := high
                candidateHighBar := bar_index
                candidateHighTime := time

            if high > candidateHigh
                candidateHigh := high
                candidateHighBar := bar_index
                candidateHighTime := time

            float upAmount = reversalAmount(candidateHigh)
            bool highConfirmed = false

            if not na(upAmount)
                if candidateHigh - low >= upAmount
                    highConfirmed := true

            if highConfirmed
                confirmedSwing := true
                confirmedType := 1
                confirmedPrice := candidateHigh
                confirmedBar := candidateHighBar
                confirmedTime := candidateHighTime

                swingDir := -1
                candidateLow := low
                candidateLowBar := bar_index
                candidateLowTime := time
                candidateHigh := na
                candidateHighBar := na
                candidateHighTime := na

        if swingDir == -1
            if na(candidateLow)
                candidateLow := low
                candidateLowBar := bar_index
                candidateLowTime := time

            if low < candidateLow
                candidateLow := low
                candidateLowBar := bar_index
                candidateLowTime := time

            float downAmount = reversalAmount(candidateLow)
            bool lowConfirmed = false

            if not na(downAmount)
                if high - candidateLow >= downAmount
                    lowConfirmed := true

            if lowConfirmed
                confirmedSwing := true
                confirmedType := -1
                confirmedPrice := candidateLow
                confirmedBar := candidateLowBar
                confirmedTime := candidateLowTime

                swingDir := 1
                candidateHigh := high
                candidateHighBar := bar_index
                candidateHighTime := time
                candidateLow := na
                candidateLowBar := na
                candidateLowTime := na

    if barstate.isconfirmed
        if confirmedSwing
            if not na(confirmedPrice)
                if not na(confirmedTime)
                    bool canStore = true

                    if array.size(zzTimes) > 0
                        int lastIndex = array.size(zzTimes) - 1
                        int lastTime = array.get(zzTimes, lastIndex)
                        int lastType = array.get(zzTypes, lastIndex)

                        if confirmedTime <= lastTime
                            canStore := false

                        if confirmedType == lastType
                            canStore := false

                    if canStore
                        array.push(zzPrices, confirmedPrice)
                        array.push(zzTypes, confirmedType)
                        array.push(zzBars, confirmedBar)
                        array.push(zzTimes, confirmedTime)

                        if array.size(zzPrices) > 300
                            array.shift(zzPrices)
                            array.shift(zzTypes)
                            array.shift(zzBars)
                            array.shift(zzTimes)

    if barstate.isconfirmed
        int n = array.size(zzPrices)

        if mtaTrend == 0
            if n >= 3
                int t1 = array.get(zzTypes, n - 3)
                int t2 = array.get(zzTypes, n - 2)
                int t3 = array.get(zzTypes, n - 1)

                float p1 = array.get(zzPrices, n - 3)
                float p2 = array.get(zzPrices, n - 2)
                float p3 = array.get(zzPrices, n - 1)

                int b2 = array.get(zzBars, n - 2)
                int tm2 = array.get(zzTimes, n - 2)
                int b3 = array.get(zzBars, n - 1)
                int tm3 = array.get(zzTimes, n - 1)

                bool bullPattern = false
                bool bearPattern = false

                if t1 == -1
                    if t2 == 1
                        if t3 == -1
                            if p3 > p1
                                if close > p2
                                    bullPattern := true

                if t1 == 1
                    if t2 == -1
                        if t3 == 1
                            if p3 < p1
                                if close < p2
                                    bearPattern := true

                if bullPattern
                    mtaTrend := 1
                    anchorPrice := p2
                    anchorBar := b2
                    anchorTime := tm2
                    mtaPrice := p3
                    mtaBar := b3
                    mtaTime := tm3
                    mtaZoneBottom := mtaPrice
                    mtaZoneTop := mtaBodyLowMinFromBar(mtaBar)
                    fivePZoneTop := anchorPrice
                    fivePZoneBottom := bodyHighAtBar(anchorBar)
                    mtaStarted := true

                if bearPattern
                    mtaTrend := -1
                    anchorPrice := p2
                    anchorBar := b2
                    anchorTime := tm2
                    mtaPrice := p3
                    mtaBar := b3
                    mtaTime := tm3
                    mtaZoneTop := mtaPrice
                    mtaZoneBottom := mtaBodyHighMaxFromBar(mtaBar)
                    fivePZoneTop := bodyLowAtBar(anchorBar)
                    fivePZoneBottom := anchorPrice
                    mtaStarted := true

        if mtaTrend == 1
            bool bullInvalid = false

            if not na(mtaPrice)
                if close < mtaPrice
                    bullInvalid := true

            if bullInvalid
                mtaTrend := 0
                mtaEnded := true
            else
                bool anchorBreak = false

                if not na(anchorPrice)
                    if close > anchorPrice
                        anchorBreak := true

                if anchorBreak
                    int breakHighIdx = -1

                    if n > 0
                        for j = 0 to n - 1
                            int tj = array.get(zzTypes, j)
                            int bj = array.get(zzBars, j)
                            float pj = array.get(zzPrices, j)

                            if tj == 1
                                if bj > anchorBar
                                    if pj > anchorPrice
                                        breakHighIdx := j

                    if breakHighIdx >= 0
                        int breakHighBar = array.get(zzBars, breakHighIdx)

                        float newLow = na
                        int newLowIdx = -1

                        if n > 0
                            for j = 0 to n - 1
                                int tj = array.get(zzTypes, j)
                                int bj = array.get(zzBars, j)
                                float pj = array.get(zzPrices, j)

                                if tj == -1
                                    if bj > anchorBar
                                        if bj < breakHighBar
                                            if na(newLow)
                                                newLow := pj
                                                newLowIdx := j
                                            else
                                                if pj < newLow
                                                    newLow := pj
                                                    newLowIdx := j

                        if newLowIdx >= 0
                            mtaPrice := array.get(zzPrices, newLowIdx)
                            mtaBar := array.get(zzBars, newLowIdx)
                            mtaTime := array.get(zzTimes, newLowIdx)
                            mtaZoneBottom := mtaPrice
                            mtaZoneTop := mtaBodyLowMinFromBar(mtaBar)

                            anchorPrice := array.get(zzPrices, breakHighIdx)
                            anchorBar := array.get(zzBars, breakHighIdx)
                            anchorTime := array.get(zzTimes, breakHighIdx)
                            fivePZoneTop := anchorPrice
                            fivePZoneBottom := bodyHighAtBar(anchorBar)

                    if breakHighIdx < 0
                        float rollingLow = na
                        int rollingLowIdx = -1

                        if n > 0
                            for j = 0 to n - 1
                                int tj = array.get(zzTypes, j)
                                int bj = array.get(zzBars, j)
                                float pj = array.get(zzPrices, j)

                                if tj == -1
                                    if bj > anchorBar
                                        if na(rollingLow)
                                            rollingLow := pj
                                            rollingLowIdx := j
                                        else
                                            if pj < rollingLow
                                                rollingLow := pj
                                                rollingLowIdx := j

                        if rollingLowIdx >= 0
                            float candidateMta = array.get(zzPrices, rollingLowIdx)
                            bool shouldUpdateRolling = false

                            if na(mtaPrice)
                                shouldUpdateRolling := true
                            else
                                if candidateMta != mtaPrice
                                    shouldUpdateRolling := true

                            if shouldUpdateRolling
                                mtaPrice := candidateMta
                                mtaBar := array.get(zzBars, rollingLowIdx)
                                mtaTime := array.get(zzTimes, rollingLowIdx)
                                mtaZoneBottom := mtaPrice
                                mtaZoneTop := mtaBodyLowMinFromBar(mtaBar)

        if mtaTrend == -1
            bool bearInvalid = false

            if not na(mtaPrice)
                if close > mtaPrice
                    bearInvalid := true

            if bearInvalid
                mtaTrend := 0
                mtaEnded := true
            else
                bool anchorBreak = false

                if not na(anchorPrice)
                    if close < anchorPrice
                        anchorBreak := true

                if anchorBreak
                    int breakLowIdx = -1

                    if n > 0
                        for j = 0 to n - 1
                            int tj = array.get(zzTypes, j)
                            int bj = array.get(zzBars, j)
                            float pj = array.get(zzPrices, j)

                            if tj == -1
                                if bj > anchorBar
                                    if pj < anchorPrice
                                        breakLowIdx := j

                    if breakLowIdx >= 0
                        int breakLowBar = array.get(zzBars, breakLowIdx)

                        float newHigh = na
                        int newHighIdx = -1

                        if n > 0
                            for j = 0 to n - 1
                                int tj = array.get(zzTypes, j)
                                int bj = array.get(zzBars, j)
                                float pj = array.get(zzPrices, j)

                                if tj == 1
                                    if bj > anchorBar
                                        if bj < breakLowBar
                                            if na(newHigh)
                                                newHigh := pj
                                                newHighIdx := j
                                            else
                                                if pj > newHigh
                                                    newHigh := pj
                                                    newHighIdx := j

                        if newHighIdx >= 0
                            mtaPrice := array.get(zzPrices, newHighIdx)
                            mtaBar := array.get(zzBars, newHighIdx)
                            mtaTime := array.get(zzTimes, newHighIdx)
                            mtaZoneTop := mtaPrice
                            mtaZoneBottom := mtaBodyHighMaxFromBar(mtaBar)

                            anchorPrice := array.get(zzPrices, breakLowIdx)
                            anchorBar := array.get(zzBars, breakLowIdx)
                            anchorTime := array.get(zzTimes, breakLowIdx)
                            fivePZoneTop := bodyLowAtBar(anchorBar)
                            fivePZoneBottom := anchorPrice

                    if breakLowIdx < 0
                        float rollingHigh = na
                        int rollingHighIdx = -1

                        if n > 0
                            for j = 0 to n - 1
                                int tj = array.get(zzTypes, j)
                                int bj = array.get(zzBars, j)
                                float pj = array.get(zzPrices, j)

                                if tj == 1
                                    if bj > anchorBar
                                        if na(rollingHigh)
                                            rollingHigh := pj
                                            rollingHighIdx := j
                                        else
                                            if pj > rollingHigh
                                                rollingHigh := pj
                                                rollingHighIdx := j

                        if rollingHighIdx >= 0
                            float candidateMta = array.get(zzPrices, rollingHighIdx)
                            bool shouldUpdateRolling = false

                            if na(mtaPrice)
                                shouldUpdateRolling := true
                            else
                                if candidateMta != mtaPrice
                                    shouldUpdateRolling := true

                            if shouldUpdateRolling
                                mtaPrice := candidateMta
                                mtaBar := array.get(zzBars, rollingHighIdx)
                                mtaTime := array.get(zzTimes, rollingHighIdx)
                                mtaZoneTop := mtaPrice
                                mtaZoneBottom := mtaBodyHighMaxFromBar(mtaBar)

    [mtaTrend, mtaPrice, mtaZoneTop, mtaZoneBottom, anchorPrice, fivePZoneTop, fivePZoneBottom, mtaStarted, mtaEnded, array.size(zzPrices)]

//=============================================================================
// HTF request.security
//=============================================================================

[htfMtaTrend, htfMtaPrice, htfMtaZoneTop, htfMtaZoneBottom, htfAnchorPrice, htfFivePZoneTop, htfFivePZoneBottom, htfMtaStarted, htfMtaEnded, htfZzCount] = request.security(syminfo.tickerid, htfTf, calcZzMtaFiveP(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

bullActive = htfMtaTrend == 1
bearActive = htfMtaTrend == -1
mtaActive = bullActive or bearActive

mtaColor = bullActive ? bullMtaColor : bearActive ? bearMtaColor : endedMtaColor
fivePColor = bullActive ? fivePBullColor : bearActive ? fivePBearColor : endedMtaColor

//=============================================================================
// HTF Plots
//=============================================================================

mtaZoneTopSeries = showHtfMtaZone and mtaActive ? htfMtaZoneTop : na
mtaZoneBottomSeries = showHtfMtaZone and mtaActive ? htfMtaZoneBottom : na

mtaZoneTopPlot = plot(mtaZoneTopSeries, title = "HTF ZZ-MTA Zone Top", color = mtaColor, linewidth = 1, style = plot.style_linebr)
mtaZoneBottomPlot = plot(mtaZoneBottomSeries, title = "HTF ZZ-MTA Zone Bottom", color = mtaColor, linewidth = 1, style = plot.style_linebr)

fill(mtaZoneTopPlot, mtaZoneBottomPlot, color = showHtfMtaZone and mtaActive ? color.new(mtaColor, 87) : na)

plot(showHtfMtaLine and mtaActive ? htfMtaPrice : na, title = "HTF ZZ-MTA Line", color = mtaColor, linewidth = 2, style = plot.style_linebr)
plot(showHtfAnchorLine and mtaActive ? htfAnchorPrice : na, title = "HTF MTA対応高値/安値", color = anchorColor, linewidth = 1, style = plot.style_linebr)

fivePZoneTopSeries = showFivePZone and mtaActive ? htfFivePZoneTop : na
fivePZoneBottomSeries = showFivePZone and mtaActive ? htfFivePZoneBottom : na

fivePZoneTopPlot = plot(fivePZoneTopSeries, title = "HTF 5P Zone Top", color = fivePColor, linewidth = 2, style = plot.style_linebr)
fivePZoneBottomPlot = plot(fivePZoneBottomSeries, title = "HTF 5P Zone Bottom", color = fivePColor, linewidth = 2, style = plot.style_linebr)

fill(fivePZoneTopPlot, fivePZoneBottomPlot, color = showFivePZone and mtaActive ? color.new(fivePColor, 82) : na)

//=============================================================================
// 5P Zone Ready / Touch
//=============================================================================

longFivePZoneReady = bullActive and not na(htfFivePZoneTop) and not na(htfFivePZoneBottom)
shortFivePZoneReady = bearActive and not na(htfFivePZoneTop) and not na(htfFivePZoneBottom)

longFivePTouch = false
shortFivePTouch = false

if longFivePZoneReady
    if low <= htfFivePZoneTop
        if high >= htfFivePZoneBottom
            longFivePTouch := true

if shortFivePZoneReady
    if high >= htfFivePZoneBottom
        if low <= htfFivePZoneTop
            shortFivePTouch := true

//=============================================================================
// LTF Pivot Engine
//=============================================================================

triggerPivotHigh = ta.pivothigh(high, triggerLeftBars, triggerRightBars)
triggerPivotLow = ta.pivotlow(low, triggerLeftBars, triggerRightBars)

isTriggerPivotHigh = not na(triggerPivotHigh)
isTriggerPivotLow = not na(triggerPivotLow)

triggerPivotBar = bar_index - triggerRightBars

var float latestPivotHigh = na
var int latestPivotHighBar = na
var float latestPivotLow = na
var int latestPivotLowBar = na

if isTriggerPivotHigh
    latestPivotHigh := triggerPivotHigh
    latestPivotHighBar := triggerPivotBar

if isTriggerPivotLow
    latestPivotLow := triggerPivotLow
    latestPivotLowBar := triggerPivotBar

//=============================================================================
// 5P Break → LTF Pivot → Away → Retest Guard
//=============================================================================

var int prevFivePTrend = 0
var float prevFivePZoneTop = na
var float prevFivePZoneBottom = na

var int fivePContextStartBar = na

var bool longFivePBreakArmed = false
var bool longFivePBreakDone = false
var int longFivePBreakBar = na
var bool longFivePPivotDone = false
var int longFivePPivotBar = na
var float longFivePPivotPrice = na
var bool longFivePRetestArmed = false

var bool shortFivePBreakArmed = false
var bool shortFivePBreakDone = false
var int shortFivePBreakBar = na
var bool shortFivePPivotDone = false
var int shortFivePPivotBar = na
var float shortFivePPivotPrice = na
var bool shortFivePRetestArmed = false

bool fivePContextChanged = false

if htfMtaTrend != prevFivePTrend
    fivePContextChanged := true

if floatChanged(htfFivePZoneTop, prevFivePZoneTop)
    fivePContextChanged := true

if floatChanged(htfFivePZoneBottom, prevFivePZoneBottom)
    fivePContextChanged := true

if fivePContextChanged
    fivePContextStartBar := bar_index

    longFivePBreakArmed := false
    longFivePBreakDone := false
    longFivePBreakBar := na
    longFivePPivotDone := false
    longFivePPivotBar := na
    longFivePPivotPrice := na
    longFivePRetestArmed := false

    shortFivePBreakArmed := false
    shortFivePBreakDone := false
    shortFivePBreakBar := na
    shortFivePPivotDone := false
    shortFivePPivotBar := na
    shortFivePPivotPrice := na
    shortFivePRetestArmed := false

    prevFivePTrend := htfMtaTrend
    prevFivePZoneTop := htfFivePZoneTop
    prevFivePZoneBottom := htfFivePZoneBottom

bodyHighNow = math.max(open, close)
bodyLowNow = math.min(open, close)

if longFivePZoneReady
    if not longFivePBreakDone
        if not longFivePBreakArmed
            if barstate.isconfirmed
                if bodyHighNow <= htfFivePZoneTop
                    longFivePBreakArmed := true

if shortFivePZoneReady
    if not shortFivePBreakDone
        if not shortFivePBreakArmed
            if barstate.isconfirmed
                if bodyLowNow >= htfFivePZoneBottom
                    shortFivePBreakArmed := true

if longFivePZoneReady
    if longFivePBreakArmed
        if not longFivePBreakDone
            if barstate.isconfirmed
                if not na(fivePContextStartBar)
                    if bar_index > fivePContextStartBar
                        if bodyHighNow[1] <= htfFivePZoneTop
                            if bodyHighNow > htfFivePZoneTop
                                longFivePBreakDone := true
                                longFivePBreakBar := bar_index

if shortFivePZoneReady
    if shortFivePBreakArmed
        if not shortFivePBreakDone
            if barstate.isconfirmed
                if not na(fivePContextStartBar)
                    if bar_index > fivePContextStartBar
                        if bodyLowNow[1] >= htfFivePZoneBottom
                            if bodyLowNow < htfFivePZoneBottom
                                shortFivePBreakDone := true
                                shortFivePBreakBar := bar_index

if longFivePBreakDone
    if not longFivePPivotDone
        if isTriggerPivotHigh
            if not na(longFivePBreakBar)
                if triggerPivotBar > longFivePBreakBar
                    longFivePPivotDone := true
                    longFivePPivotBar := triggerPivotBar
                    longFivePPivotPrice := triggerPivotHigh

if shortFivePBreakDone
    if not shortFivePPivotDone
        if isTriggerPivotLow
            if not na(shortFivePBreakBar)
                if triggerPivotBar > shortFivePBreakBar
                    shortFivePPivotDone := true
                    shortFivePPivotBar := triggerPivotBar
                    shortFivePPivotPrice := triggerPivotLow

if longFivePPivotDone
    if not longFivePRetestArmed
        if barstate.isconfirmed
            if bodyLowNow > htfFivePZoneTop
                longFivePRetestArmed := true

if shortFivePPivotDone
    if not shortFivePRetestArmed
        if barstate.isconfirmed
            if bodyHighNow < htfFivePZoneBottom
                shortFivePRetestArmed := true

longFivePRetestTouch = false
shortFivePRetestTouch = false

if longFivePZoneReady
    if longFivePRetestArmed
        if barstate.isconfirmed
            if bodyLowNow[1] > htfFivePZoneTop
                if low <= htfFivePZoneTop
                    if high >= htfFivePZoneBottom
                        longFivePRetestTouch := true

if shortFivePZoneReady
    if shortFivePRetestArmed
        if barstate.isconfirmed
            if bodyHighNow[1] < htfFivePZoneBottom
                if high >= htfFivePZoneBottom
                    if low <= htfFivePZoneTop
                        shortFivePRetestTouch := true

longFivePSetupSignal = false
shortFivePSetupSignal = false

if longFivePZoneReady
    if longFivePBreakDone
        if longFivePPivotDone
            if longFivePRetestArmed
                if longFivePRetestTouch
                    longFivePSetupSignal := true

if shortFivePZoneReady
    if shortFivePBreakDone
        if shortFivePPivotDone
            if shortFivePRetestArmed
                if shortFivePRetestTouch
                    shortFivePSetupSignal := true

//=============================================================================
// B5.2 Setup / Trigger State
//=============================================================================

var bool longSetupActive = false
var bool shortSetupActive = false
var bool longTriggerFired = false
var bool shortTriggerFired = false

var int longSetupTime = na
var int shortSetupTime = na

var float longBreakHigh = na
var int longBreakHighBar = na
var float shortBreakLow = na
var int shortBreakLowBar = na

var float longFivePSl = na
var float shortFivePSl = na

var label setupLabel = na
var label longBreakLabel = na
var label shortBreakLabel = na
var label longSlLabel = na
var label shortSlLabel = na

expireMs = triggerExpireMinutes * 60 * 1000

canStartNewSetup = not longSetupActive and not shortSetupActive

longFivePSetupStart = false
shortFivePSetupStart = false

if longFivePSetupSignal
    if canStartNewSetup
        longSetupActive := true
        shortSetupActive := false
        longTriggerFired := false
        shortTriggerFired := false
        longSetupTime := time
        shortSetupTime := na

        longBreakHigh := longFivePPivotPrice
        longBreakHighBar := longFivePPivotBar
        shortBreakLow := na
        shortBreakLowBar := na

        longFivePSl := htfFivePZoneBottom
        shortFivePSl := na

        longFivePSetupStart := true

        if not na(setupLabel)
            label.delete(setupLabel)
            setupLabel := na

        if not na(longBreakLabel)
            label.delete(longBreakLabel)
            longBreakLabel := na

        if not na(shortBreakLabel)
            label.delete(shortBreakLabel)
            shortBreakLabel := na

        if not na(longSlLabel)
            label.delete(longSlLabel)
            longSlLabel := na

        if not na(shortSlLabel)
            label.delete(shortSlLabel)
            shortSlLabel := na

        if showFivePSetupLabels
            setupLabel := label.new(bar_index, low, "Long 5P Setup\nBreak → Pivot → Away → Retest", style = label.style_label_up, textcolor = color.white, color = setupLongColor, size = size.small)

        if showTriggerPivots
            if not na(longBreakHigh)
                if not na(longBreakHighBar)
                    longBreakLabel := label.new(longBreakHighBar, longBreakHigh, "5P Pre H\nFixed", style = label.style_label_down, textcolor = color.white, color = color.orange, size = size.tiny)

        if showFivePSlLine
            if not na(longFivePSl)
                longSlLabel := label.new(bar_index, longFivePSl, "5P SL", style = label.style_label_left, textcolor = color.black, color = slColor, size = size.tiny)

        longFivePBreakArmed := false
        longFivePBreakDone := false
        longFivePBreakBar := na
        longFivePPivotDone := false
        longFivePPivotBar := na
        longFivePPivotPrice := na
        longFivePRetestArmed := false

if shortFivePSetupSignal
    if canStartNewSetup
        shortSetupActive := true
        longSetupActive := false
        shortTriggerFired := false
        longTriggerFired := false
        shortSetupTime := time
        longSetupTime := na

        shortBreakLow := shortFivePPivotPrice
        shortBreakLowBar := shortFivePPivotBar
        longBreakHigh := na
        longBreakHighBar := na

        shortFivePSl := htfFivePZoneTop
        longFivePSl := na

        shortFivePSetupStart := true

        if not na(setupLabel)
            label.delete(setupLabel)
            setupLabel := na

        if not na(longBreakLabel)
            label.delete(longBreakLabel)
            longBreakLabel := na

        if not na(shortBreakLabel)
            label.delete(shortBreakLabel)
            shortBreakLabel := na

        if not na(longSlLabel)
            label.delete(longSlLabel)
            longSlLabel := na

        if not na(shortSlLabel)
            label.delete(shortSlLabel)
            shortSlLabel := na

        if showFivePSetupLabels
            setupLabel := label.new(bar_index, high, "Short 5P Setup\nBreak → Pivot → Away → Retest", style = label.style_label_down, textcolor = color.white, color = setupShortColor, size = size.small)

        if showTriggerPivots
            if not na(shortBreakLow)
                if not na(shortBreakLowBar)
                    shortBreakLabel := label.new(shortBreakLowBar, shortBreakLow, "5P Pre L\nFixed", style = label.style_label_up, textcolor = color.white, color = color.red, size = size.tiny)

        if showFivePSlLine
            if not na(shortFivePSl)
                shortSlLabel := label.new(bar_index, shortFivePSl, "5P SL", style = label.style_label_left, textcolor = color.black, color = slColor, size = size.tiny)

        shortFivePBreakArmed := false
        shortFivePBreakDone := false
        shortFivePBreakBar := na
        shortFivePPivotDone := false
        shortFivePPivotBar := na
        shortFivePPivotPrice := na
        shortFivePRetestArmed := false

//=============================================================================
// Setup Expire / Invalid
//=============================================================================

longExpired = false
shortExpired = false

if longSetupActive
    if not na(longSetupTime)
        if time - longSetupTime > expireMs
            longExpired := true

if shortSetupActive
    if not na(shortSetupTime)
        if time - shortSetupTime > expireMs
            shortExpired := true

longInvalidByHtfMta = longSetupActive and htfMtaTrend != 1
shortInvalidByHtfMta = shortSetupActive and htfMtaTrend != -1

if longExpired
    longSetupActive := false
    longFivePSl := na
    if showInvalidLabels
        label.new(bar_index, close, "Long 5P Expired", style = label.style_label_left, textcolor = color.white, color = endedMtaColor, size = size.small)

if shortExpired
    shortSetupActive := false
    shortFivePSl := na
    if showInvalidLabels
        label.new(bar_index, close, "Short 5P Expired", style = label.style_label_left, textcolor = color.white, color = endedMtaColor, size = size.small)

if longInvalidByHtfMta
    longSetupActive := false
    longFivePSl := na
    if showInvalidLabels
        label.new(bar_index, low, "Long 5P Invalid\nZZ-MTA End", style = label.style_label_up, textcolor = color.white, color = endedMtaColor, size = size.small)

if shortInvalidByHtfMta
    shortSetupActive := false
    shortFivePSl := na
    if showInvalidLabels
        label.new(bar_index, high, "Short 5P Invalid\nZZ-MTA End", style = label.style_label_down, textcolor = color.white, color = endedMtaColor, size = size.small)

//=============================================================================
// B5.2 Trigger
//=============================================================================

longTrigger = false
shortTrigger = false

currentBodyHigh = math.max(open, close)
currentBodyLow = math.min(open, close)

if longSetupActive
    if not longTriggerFired
        if not na(longBreakHigh)
            if barstate.isconfirmed
                if currentBodyHigh > longBreakHigh
                    longTrigger := true
                    longTriggerFired := true
                    longSetupActive := false
                    if showTriggerLabels
                        label.new(bar_index, high, "Long 5P Trigger\nPre H Body Break", style = label.style_label_down, textcolor = color.white, color = triggerLongColor, size = size.normal)

if shortSetupActive
    if not shortTriggerFired
        if not na(shortBreakLow)
            if barstate.isconfirmed
                if currentBodyLow < shortBreakLow
                    shortTrigger := true
                    shortTriggerFired := true
                    shortSetupActive := false
                    if showTriggerLabels
                        label.new(bar_index, low, "Short 5P Trigger\nPre L Body Break", style = label.style_label_up, textcolor = color.white, color = triggerShortColor, size = size.normal)

//=============================================================================
// SL Candidate Plot
//=============================================================================

plot(showFivePSlLine and longSetupActive ? longFivePSl : na, title = "Long 5P SL Candidate", color = slColor, linewidth = 2, style = plot.style_linebr)
plot(showFivePSlLine and shortSetupActive ? shortFivePSl : na, title = "Short 5P SL Candidate", color = slColor, linewidth = 2, style = plot.style_linebr)

//=============================================================================
// Shapes / Alerts / Debug
//=============================================================================

plotshape(showFivePSetupLabels and longFivePSetupStart, title = "Long 5P Setup", style = shape.circle, location = location.belowbar, color = setupLongColor, size = size.tiny, text = "5P-L")
plotshape(showFivePSetupLabels and shortFivePSetupStart, title = "Short 5P Setup", style = shape.circle, location = location.abovebar, color = setupShortColor, size = size.tiny, text = "5P-S")

plotshape(showTriggerLabels and longTrigger, title = "Long 5P Trigger", style = shape.triangleup, location = location.belowbar, color = triggerLongColor, size = size.small, text = "L-TRIG")
plotshape(showTriggerLabels and shortTrigger, title = "Short 5P Trigger", style = shape.triangledown, location = location.abovebar, color = triggerShortColor, size = size.small, text = "S-TRIG")

setupState = longSetupActive ? 1 : shortSetupActive ? -1 : 0

plot(showDebug ? htfMtaTrend : na, title = "HTF ZZ-MTA Trend", display = display.data_window)
plot(showDebug ? htfMtaPrice : na, title = "HTF ZZ-MTA Price", display = display.data_window)
plot(showDebug ? htfMtaZoneTop : na, title = "HTF ZZ-MTA Zone Top", display = display.data_window)
plot(showDebug ? htfMtaZoneBottom : na, title = "HTF ZZ-MTA Zone Bottom", display = display.data_window)
plot(showDebug ? htfAnchorPrice : na, title = "HTF Anchor Price", display = display.data_window)
plot(showDebug ? htfFivePZoneTop : na, title = "HTF 5P Zone Top", display = display.data_window)
plot(showDebug ? htfFivePZoneBottom : na, title = "HTF 5P Zone Bottom", display = display.data_window)
plot(showDebug ? htfZzCount : na, title = "HTF ZZ Count", display = display.data_window)
plot(showDebug ? setupState : na, title = "5P Setup State", display = display.data_window)
plot(showDebug ? longBreakHigh : na, title = "Long 5P Pre H", display = display.data_window)
plot(showDebug ? shortBreakLow : na, title = "Short 5P Pre L", display = display.data_window)
plot(showDebug ? longFivePSl : na, title = "Long 5P SL", display = display.data_window)
plot(showDebug ? shortFivePSl : na, title = "Short 5P SL", display = display.data_window)

plot(showDebug ? (longFivePBreakArmed ? 1 : 0) : na, title = "Long 5P Break Armed", display = display.data_window)
plot(showDebug ? (longFivePBreakDone ? 1 : 0) : na, title = "Long 5P Break Done", display = display.data_window)
plot(showDebug ? (longFivePPivotDone ? 1 : 0) : na, title = "Long 5P Pivot Done", display = display.data_window)
plot(showDebug ? (longFivePRetestArmed ? 1 : 0) : na, title = "Long 5P Retest Armed", display = display.data_window)
plot(showDebug ? longFivePPivotPrice : na, title = "Long 5P Pivot Price", display = display.data_window)

plot(showDebug ? (shortFivePBreakArmed ? 1 : 0) : na, title = "Short 5P Break Armed", display = display.data_window)
plot(showDebug ? (shortFivePBreakDone ? 1 : 0) : na, title = "Short 5P Break Done", display = display.data_window)
plot(showDebug ? (shortFivePPivotDone ? 1 : 0) : na, title = "Short 5P Pivot Done", display = display.data_window)
plot(showDebug ? (shortFivePRetestArmed ? 1 : 0) : na, title = "Short 5P Retest Armed", display = display.data_window)
plot(showDebug ? shortFivePPivotPrice : na, title = "Short 5P Pivot Price", display = display.data_window)

alertcondition(longFivePSetupStart, title = "Long 5P Setup", message = "Long 5P Setup: Break Pivot Away Retest completed")
alertcondition(shortFivePSetupStart, title = "Short 5P Setup", message = "Short 5P Setup: Break Pivot Away Retest completed")
alertcondition(longTrigger, title = "Long 5P Trigger", message = "Long 5P Trigger: Pre H body break")
alertcondition(shortTrigger, title = "Short 5P Trigger", message = "Short 5P Trigger: Pre L body break")
